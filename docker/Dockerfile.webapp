# Build stage
FROM node:23-alpine AS build-stage

LABEL org.opencontainers.image.title="TagEveryoneTelegramBot Mini App"
LABEL org.opencontainers.image.authors="Matt0550"

WORKDIR /app

# Copy dependency files first (cacheable layer)
COPY src/tg_mini_app/package*.json ./

# Install dependencies
RUN npm ci

# Copy the rest of the mini app source
COPY src/tg_mini_app/ .

# Build-time args for Vite env vars
ARG VITE_BOT_USERNAME
ARG VITE_API_URL

ENV VITE_BOT_USERNAME=$VITE_BOT_USERNAME
ENV VITE_API_URL=$VITE_API_URL

# Build the app
RUN npm run build

# Production stage — serve static files with nginx
FROM nginx:alpine AS production-stage

# Copy built files from build stage
COPY --from=build-stage /app/dist /usr/share/nginx/html

# SPA fallback — serve index.html for all routes
RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    \n\
    location / {\n\
    try_files $uri $uri/ /index.html;\n\
    }\n\
    \n\
    location ~* \\.(?:css|js|svg|png|jpg|jpeg|gif|ico|woff2?|ttf|eot)$ {\n\
    expires 1y;\n\
    add_header Cache-Control "public, immutable";\n\
    }\n\
    }\n' > /etc/nginx/conf.d/default.conf

# Create non-root user for nginx
RUN addgroup -g 1001 -S nginx-user && \
    adduser -S -D -H -u 1001 -h /var/cache/nginx -s /sbin/nologin -G nginx-user -g nginx-user nginx-user

# Setup directories and permissions
RUN chown -R nginx-user:nginx-user /usr/share/nginx/html && \
    chown -R nginx-user:nginx-user /var/cache/nginx && \
    chown -R nginx-user:nginx-user /var/log/nginx && \
    chown -R nginx-user:nginx-user /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R nginx-user:nginx-user /var/run/nginx.pid

# Switch to non-root user
USER nginx-user

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
